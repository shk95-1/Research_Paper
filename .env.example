# OpenAlex 무료 API 키. 사실상 필수 — 없으면 무인증 예산(하루 1,000크레딧,
# search 기준 ~100건)에 묶인다. https://openalex.org 에서 무료 발급.
OPENALEX_API_KEY=

# 연락처 이메일. OpenAlex 자체는 2026-02-13부터 mailto/polite pool 을 폐지해
# 더 이상 이 값을 받지 않는다 — 지금은 Crossref polite 풀(단건 DOI 조회)과
# Unpaywall 의 필수 email 파라미터에만 쓰인다.
OPENALEX_EMAIL=

# Semantic Scholar API 키. 강력 권장 — 익명 풀은 429 가 잦아 4초 간격으로
# 늦춘다. 키가 있으면 1초 간격(1req/s)으로 좁아진다. 무료 발급.
SEMANTIC_SCHOLAR_API_KEY=

# NCBI(PubMed E-utilities) API 키. 선택 — 없으면 3req/s, 있으면 10req/s.
# https://www.ncbi.nlm.nih.gov/account/ 에서 무료 발급.
NCBI_API_KEY=
